# AutoEase Backend Environment Variables
# Copy this to .env and fill in your values

# Server
PORT=5000
NODE_ENV=development

# Database (MySQL / Amazon RDS)
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your_password_here
DB_NAME=autoease_db

# For AWS RDS, set DB_HOST to your RDS endpoint:
# DB_HOST=autoease-db.xxxxxxxxxxxx.us-east-1.rds.amazonaws.com

# JWT
JWT_SECRET=your_super_secret_jwt_key_here_change_this
JWT_EXPIRES_IN=7d

# Frontend URL (for CORS)
FRONTEND_URL=http://localhost:3000

# For AWS: set this to your CloudFront/EC2 URL
# FRONTEND_URL=https://your-cloudfront-domain.cloudfront.net
